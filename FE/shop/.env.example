# ===================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG FRONTEND (REACT + VITE)
# Hướng dẫn: Copy file này thành .env trong thư mục FE/shop
# File .env đã được cấu hình trong .gitignore, không bị đẩy lên Git
# ===================================================================

# 1. Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080

# 2. Google Gemini API Key cho Bot Chat AI Tư Vấn Y Tế
# Lấy API Key miễn phí tại: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here