# =================================================================
# FILE MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN (SAMPLE ENVIRONMENT FILE)
# =================================================================
# Hướng dẫn: Copy file này thành .env để cấu hình trên máy của bạn.
# File .env đã được cấu hình trong .gitignore, hoàn toàn an toàn và không bị đẩy lên Git.

# 1. Cơ sở dữ liệu MySQL (Database)
MYSQL_DATABASE=ecommerce_db
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=your_secure_password_here

# 2. Cấu hình Backend Spring Boot
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# 3. Khóa bí mật JWT (Tối thiểu 32 ký tự ngẫu nhiên)
APP_JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_string

# 4. Cấu hình gửi Mail thông báo tự động (Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_16_digit_app_password
APP_ADMIN_NOTIFICATION_EMAIL=lienkehoach@gmail.com

# 5. Cấu hình Frontend (React Vite)
VITE_API_BASE_URL=http://localhost:8080/api
