# Database MySQL
MYSQL_DATABASE=ecommerce_db
MYSQL_ROOT_PASSWORD=bop123
MYSQL_PORT=3306

# Backend Configuration
BACKEND_PORT=8080
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=bop123
